server {
  listen 80;
  server_name {{ cuttlefish_domain }};

  # Redirect all HTTP to HTTPS
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name {{ cuttlefish_domain }};

  root /srv/www/current/public;
  passenger_enabled on;
  passenger_ruby /usr/local/lib/rvm/wrappers/default/ruby;
  passenger_app_env production;

  location ^~ /assets/ {
    gzip_static on;
    expires max;
    add_header Cache-Control public;
  }

  ssl_certificate /etc/letsencrypt/live/{{ cuttlefish_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ cuttlefish_domain }}/privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:50m;
  ssl_stapling on;
  ssl_stapling_verify on;
}
