---
# Copy this file to secrets.yml, fill in your values, then encrypt it:
#
#   cp provisioning/group_vars/all/secrets.yml.example provisioning/group_vars/all/secrets.yml
#   # fill in all values, then:
#   ansible-vault encrypt provisioning/group_vars/all/secrets.yml
#
# secrets.yml is gitignored — never commit the plaintext version.
# See README.md for full vault setup instructions.
#
# Generate Rails secrets with: rails secret
# Generate random strings with: openssl rand -hex 32

# GitHub usernames whose public keys will be authorized for SSH access.
# Keys are fetched automatically from https://github.com/<username>.keys
github_users:
  - your-github-username

# Rails application secrets
secret_key_base: ""
devise_secret_key: ""
jwt_secret: ""

# Random string for hashing email tracking links
cuttlefish_hash_salt: ""

# PostgreSQL password for the cuttlefish database user
db_password: ""

# Email address for Let's Encrypt certificate registration and renewal notices
certbot_email: ""

# Optional: Google Analytics tracking code (e.g. G-XXXXXXXXXX)
# google_analytics_code: ""

# Optional: AWS S3 for email archive storage
# s3_bucket: ""
# aws_access_key_id: ""
# aws_secret_access_key: ""

# Optional: AWS/Duplicity backup credentials
# encrypted_backup_aws_access_key: ""
# encrypted_backup_secret_access_key: ""
# encrypted_backup_passphrase: ""

# Optional: New Relic monitoring (also set new_relic_enabled: true in group_vars/all)
# new_relic_license_key: ""

# Optional: Honeybadger error tracking
# honeybadger_api_key: ""
