# Pick this to be the same as .ruby-version
FROM ruby:3.3

# Create deploy user and /app with correct ownership in one layer
RUN groupadd --gid 1000 deploy \
    && useradd --uid 1000 --gid 1000 -m deploy \
    && mkdir -p /app \
    && chown deploy:deploy /app

WORKDIR /app

RUN apt-get update && apt-get install -y \
  build-essential \
  nodejs

USER deploy

COPY --chown=deploy:deploy Gemfile ./
RUN gem install bundler && bundle install --jobs 20 --retry 5

CMD ["/bin/sh", "-c", "rm -f tmp/pids/server.pid && bundle exec rails server -b 0.0.0.0"]
